# Supabase 대시보드 > Project Settings > API 에서 값을 복사해 이 파일을 .env 로 저장하세요.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key


# ─── 아래 두 값은 .env 가 아니라 .env.local 에 넣으세요 (.env 는 git 에 커밋됩니다) ───
# '피식' 배치용 service_role 키: 서버에서만 사용, VITE_ 를 붙이지 마세요 (브라우저에 노출되면 안 됨)
# Project Settings > API > service_role
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Vercel 에서만: 아무 긴 랜덤 문자열. Vercel Cron 이 이 값으로 /api/cron/comic 을 호출합니다.
# CRON_SECRET=
